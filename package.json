{
  "name": "react-router-intents",
  "version": "0.1.1",
  "description": "Typed action intents for React Router, with configurable defaults and native escape hatches.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "10KB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10KB/react-router-intents.git"
  },
  "bugs": {
    "url": "https://github.com/10KB/react-router-intents/issues"
  },
  "homepage": "https://github.com/10KB/react-router-intents#readme",
  "keywords": [
    "react",
    "react-router",
    "actions",
    "intents",
    "typescript",
    "fetcher",
    "spa"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node --experimental-strip-types scripts/test-package.ts",
    "verify": "npm run lint:ci && npm run build && npm run typecheck && npm test && npm run test:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router": "^7.18.3 || ^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
